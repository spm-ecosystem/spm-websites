{
    "components": [
        {
            "action": "hide",
            "selector": "form[action*='login']:last-of-type, body:has(form[action*='login']) > b, body:has(form[action*='login']) > a, body:has(form[action*='login']) > br"
        },
        {
            "action": "hide",
            "selector": "form:has(input[name='q'])"
        }
    ],
    "reconstructs": [
        {
            "children": [
                {
                    "name": "fields",
                    "propsMap": {
                        "defaultValue": "input, textarea | attr:value",
                        "id": "input, textarea | attr:name",
                        "label": "td:first-child | text",
                        "placeholder": "input, textarea | attr:placeholder",
                        "type": "input, textarea | attr:type"
                    },
                    "selector": "tr:has(input)"
                }
            ],
            "containerSelector": "form[action*='login']:first-of-type",
            "layoutComponent": "UiFormContainer",
            "props": {
                "activeTabId": "login",
                "forgotPasswordUrl": "forgot",
                "style": "max-width: 480px; margin: 40px auto;",
                "tabs": "[{id:\"login\",label:\"Fazer Login\",title:\"Login no Hacker News\",subTitle:\"Entre com suas credenciais para continuar\",actionUrl:\"login\",submitLabel:\"Entrar\"},{id:\"register\",label:\"Criar Conta\",title:\"Criar Nova Conta\",subTitle:\"Cadastre seu usuário para enviar histórias e comentar\",actionUrl:\"login\",submitLabel:\"Criar Conta\",hiddenInputs:{creating:\"t\"}}]"
            },
            "urlPattern": "news\\.ycombinator\\.com\\/login"
        },
        {
            "children": [
                {
                    "name": "fields",
                    "propsMap": {
                        "defaultValue": "input, textarea | attr:value",
                        "id": "input, textarea | attr:name",
                        "label": "td:first-child | text",
                        "placeholder": "input, textarea | attr:placeholder",
                        "type": "input, textarea | attr:type"
                    },
                    "selector": "tr:has(input), tr:has(textarea)"
                }
            ],
            "containerSelector": "form[action='r']",
            "layoutComponent": "UiFormContainer",
            "props": {
                "actionUrl": "r",
                "method": "post",
                "style": "max-width: 600px; margin: 40px auto;",
                "subTitle": "Insira uma URL para compartilhar um link ou preencha o texto para Ask/Show HN",
                "submitLabel": "Publicar História",
                "title": "Enviar História para o Hacker News"
            },
            "urlPattern": "news\\.ycombinator\\.com\\/submit"
        },
        {
            "children": [
                {
                    "name": "primaryLinks",
                    "propsMap": {
                        "label": "self | text",
                        "url": "self | attr:href"
                    },
                    "selector": "span.pagetop a:not(.hnname a):not([href*='login']):not([href*='logout'])"
                },
                {
                    "name": "secondaryLinks",
                    "propsMap": {
                        "label": "self | text",
                        "url": "self | attr:href"
                    },
                    "selector": "td[style*='text-align:right'] a, span.pagetop a[href*='login'], span.pagetop a[href*='logout']"
                }
            ],
            "containerSelector": ".hnmain tr:first-child > td",
            "layoutComponent": "UiNavHeader",
            "props": {
                "logoHref": "/",
                "logoUrl": "https://news.ycombinator.com/y18.svg",
                "siteName": "Hacker News",
                "sticky": true
            }
        }
    ],
    "targetUrl": "*://news.ycombinator.com/*",
    "theme": {
        "cssVariables": {
            "--spm-accent": "#ff6600",
            "--spm-bg-element": "#27272a",
            "--spm-bg-primary": "#060606",
            "--spm-bg-secondary": "#121215",
            "--spm-bg-surface": "#18181b",
            "--spm-border": "rgba(255, 102, 0, 0.2)",
            "--spm-border-contrast": "rgba(255, 102, 0, 0.3)",
            "--spm-card-radius": "8px",
            "--spm-container-max-width": "100%",
            "--spm-form-padding": "24px",
            "--spm-nav-padding": "10px 16px",
            "--spm-radius": "8px",
            "--spm-text-muted": "#a1a1aa",
            "--spm-text-primary": "#f4f4f5",
            "--spm-text-subtle": "#71717a"
        },
        "customStyles": "",
        "label": "Dark Modern HN"
    }
}
