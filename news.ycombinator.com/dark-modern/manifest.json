{
    "components": [
        {
            "action": "hide",
            "selector": "#hnmain > tbody > tr:nth-child(2)"
        }
    ],
    "reconstructs": [
        {
            "children": [
                {
                    "name": "posts",
                    "propsMap": {
                        "author": "a.hnuser | text",
                        "commentsCount": "a:last-child | text",
                        "domain": "span.sitestr | text",
                        "points": "span.score | text",
                        "rank": "span.rank | text",
                        "timeAgo": "span.age | text",
                        "title": "span.titleline a | text",
                        "url": "span.titleline a | attr:href"
                    },
                    "selector": "tr.athing"
                }
            ],
            "containerSelector": "table.itemlist",
            "layoutComponent": "UiTableListPage",
            "props": {
                "pageTitle": "Hacker News - Front Page",
                "searchPlaceholder": "Search stories..."
            }
        },
        {
            "children": [
                {
                    "name": "comments",
                    "propsMap": {
                        "author": "a.hnuser | text",
                        "commentText": "div.comment span.commtext | html",
                        "timeAgo": "span.age | text"
                    },
                    "selector": "tr.athing.comtr"
                }
            ],
            "containerSelector": "table.comment-tree",
            "layoutComponent": "UiCommentListPage",
            "props": {
                "pageTitle": "Discussion Thread"
            }
        },
        {
            "children": [],
            "containerSelector": "form.comment-form",
            "layoutComponent": "UiSearchBar",
            "preserve": {
                "hiddenInputs": "form | hiddenInputs"
            },
            "props": {
                "placeholder": "Add your comment..."
            }
        },
        {
            "children": [],
            "containerSelector": "table#hnmain > tbody > tr:first-child",
            "layoutComponent": "UiNavHeader",
            "props": {
                "logoUrl": "https://news.ycombinator.com/y18.svg",
                "searchPlaceholder": "Search posts, comments, authors...",
                "siteName": "Hacker News"
            },
            "propsMap": {
                "linkAsk": "span.pagetop a[href='ask'] | text",
                "linkComments": "span.pagetop a[href='newcomments'] | text",
                "linkJobs": "span.pagetop a[href='jobs'] | text",
                "linkNew": "span.pagetop a[href='newest'] | text",
                "linkPast": "span.pagetop a[href='front'] | text",
                "linkShow": "span.pagetop a[href='show'] | text",
                "linkSubmit": "span.pagetop a[href='submit'] | text"
            }
        }
    ],
    "theme": {
        "cssVariables": {
            "--spm-accent": "#ff6600",
            "--spm-bg-element": "#27272a",
            "--spm-bg-primary": "#060606",
            "--spm-bg-secondary": "#121212",
            "--spm-bg-surface": "#18181b",
            "--spm-border-contrast": "rgba(255, 255, 255, 0.12)",
            "--spm-text-muted": "#a1a1aa",
            "--spm-text-primary": "#f4f4f5",
            "--spm-text-subtle": "#71717a"
        },
        "customStyles": "body { background-color: #060606 !important; color: #f4f4f5 !important; font-family: 'Inter', system-ui, sans-serif !important; margin: 0; padding: 0; }\n#hnmain { background-color: transparent !important; width: 100% !important; max-width: 1100px !important; margin: 0 auto !important; border: none !important; }\ntr.spacer { height: 10px !important; }\ntd { color: #a1a1aa !important; font-size: 13px !important; }\na { color: #f4f4f5 !important; text-decoration: none !important; transition: color 0.15s !important; }\na:hover { color: #ff6600 !important; text-decoration: underline !important; }\n.votearrow { filter: invert(0.6) sepia(1) saturate(5) hue-rotate(350deg) !important; cursor: pointer !important; }\ntextarea, input[type='text'] { background: #18181b !important; color: #fff !important; border: 1px solid rgba(255,255,255,0.15) !important; border-radius: 4px !important; padding: 8px 12px !important; }\n.comment { color: #d4d4d8 !important; font-size: 14px !important; line-height: 1.6 !important; margin-top: 6px !important; }",
        "label": "DarkModernHN"
    }
}
