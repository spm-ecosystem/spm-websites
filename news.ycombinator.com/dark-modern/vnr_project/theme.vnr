theme "Dark Modern HN" {
  variables {
    --spm-bg-primary: "#060606";
    --spm-bg-secondary: "#121215";
    --spm-bg-surface: "#18181b";
    --spm-bg-element: "#27272a";
    --spm-text-primary: "#f4f4f5";
    --spm-text-muted: "#a1a1aa";
    --spm-text-subtle: "#71717a";
    --spm-accent: "#ff6600";
    --spm-border: "rgba(255, 102, 0, 0.2)";
    --spm-border-contrast: "rgba(255, 102, 0, 0.3)";
    --spm-radius: "8px";
  }

  customStyles {
    "body { background-color: #060606 !important; color: #f4f4f5 !important; font-family: 'Inter', system-ui, sans-serif !important; margin: 0; padding: 0; }"
    "#hnmain { background-color: transparent !important; width: 100% !important; max-width: 960px !important; margin: 1.5rem auto 5rem auto !important; border: none !important; padding: 0 1.5rem !important; }"
    "td[bgcolor='#ff6600'] { background: transparent !important; padding-bottom: 16px !important; border: none !important; }"
    "tr.spacer { height: 10px !important; }"
    "td { color: #a1a1aa !important; font-size: 13px !important; }"
    "a { color: #f4f4f5 !important; text-decoration: none !important; transition: color 0.15s !important; }"
    "a:hover { color: #ff6600 !important; text-decoration: underline !important; }"
    ".votearrow { filter: invert(0.6) sepia(1) saturate(5) hue-rotate(350deg) !important; cursor: pointer !important; }"
    "textarea, input[type='text'] { background: #18181b !important; color: #fff !important; border: 1px solid rgba(255,102,0,0.2) !important; border-radius: 6px !important; padding: 8px 12px !important; }"
    ".comment { color: #d4d4d8 !important; font-size: 14px !important; line-height: 1.6 !important; margin-top: 6px !important; }"
  }
}
