reconstruct "td[bgcolor='#ff6600']" -> UiNavHeader {
    siteName: "Hacker News";
    logoUrl: "https://news.ycombinator.com/y18.svg";
    logoHref: "/";
    sticky: "true";

    child primaryLinks {
        selector: "span.pagetop > a";
        bind label: "self | text";
        bind url: "self | attr:href";
    }

    child secondaryLinks {
        selector: "td[style*='text-align:right'] a";
        bind label: "self | text";
        bind url: "self | attr:href";
    }
}
