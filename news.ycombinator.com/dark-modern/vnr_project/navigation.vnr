reconstruct "tr:first-child > td[bgcolor='#ff6600']" -> UiNavHeader {
    siteName: "Hacker News";
    logoUrl: "https://news.ycombinator.com/y18.svg";
    logoHref: "/";
    sticky: "true";
    extraHtml: "<span style='background: rgba(255, 102, 0, 0.15); color: #ff6600; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 12px; border: 1px solid rgba(255, 102, 0, 0.3); letter-spacing: 0.5px; margin-left: 8px;'>DARK MODERN</span>";

    child primaryLinks {
        selector: "span.pagetop a:not(.hnname a):not([href*='login']):not([href*='logout'])";
        bind label: "self | text";
        bind url: "self | attr:href";
    }

    child secondaryLinks {
        selector: "td[style*='text-align:right'] a, span.pagetop a[href*='login'], span.pagetop a[href*='logout']";
        bind label: "self | text";
        bind url: "self | attr:href";
    }
}
