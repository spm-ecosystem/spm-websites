reconstruct "#hnmain > tbody > tr:first-child > td" -> UiNavHeader {
    siteName: "Hacker News";
    logoUrl: "https://news.ycombinator.com/y18.svg";
    logoHref: "/";
    sticky: "true";

    child primaryLinks {
        selector: "span.pagetop a";
        bind label: "self | text";
        bind url: "self | attr:href";
    }
}
