class HNStoryItem {
    bind rank: "td.title .rank | text";
    bind title: "td.title .titleline > a | text";
    bind url: "td.title .titleline > a | attr:href";
    bind domain: "td.title .titleline .sitestr | text";
    bind points: "+ tr td.subtext .score | text";
    bind author: "+ tr td.subtext a.hnuser | text";
    bind timeAgo: "+ tr td.subtext span.age | text";
    bind commentsCount: "+ tr td.subtext a:last-child | text";
}

class HNCommentItem {
    bind author: "a.hnuser | text";
    bind date: "span.age | text";
    bind body: "div.comment span.commtext | html";
}

class HNFormFieldItem {
    bind id: "input, textarea | attr:name";
    bind label: "td:first-child | text";
    bind type: "input, textarea | attr:type";
    bind placeholder: "input, textarea | attr:placeholder";
    bind defaultValue: "input, textarea | attr:value";
}
