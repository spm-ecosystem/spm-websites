theme "Obsidian" {
    variables {
        --spm-bg-primary: "#000000";
        --spm-bg-secondary: "#111111";
        --spm-bg-tertiary: "#222222";
        --spm-text-primary: "#ffffff";
        --spm-text-muted: "#a1a1aa";
        --spm-accent: "#7c6af5";
        --spm-accent-hover: "#9d8fff";
        --spm-accent-fg: "#ffffff";
        --spm-border: "#333333";
        --spm-radius: "10px";
        --spm-card-radius: "8px";
        --spm-nav-padding: "10px 16px";
        --spm-container-max-width: "100%";
        --spm-form-padding: "24px";
    }
}
